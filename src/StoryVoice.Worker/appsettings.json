{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=storyvoice;Username=storyvoice;Password=storyvoice_local"
  },
  "VoAi": {
    "BaseUrl": "https://connect.voai.ai/",
    "TimeoutSeconds": 300,
    "MaximumResponseBytes": 67108864,
    "MaximumJobResponseBytes": 4294967296,
    "MaximumChunksPerJob": 5000,
    "SampleRate": 32000
  },
  "BlueMagpie": {
    "MaximumResponseBytes": 5242880,
    "MaximumChunksPerJob": 10000,
    "MaximumJobAudioBytes": 8589934592
  },
  "AudioComposer": {
    "EnableLoudnessNormalization": true,
    "TargetIntegratedLoudness": -16.0,
    "TargetTruePeak": -1.5,
    "TargetLoudnessRange": 11.0
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  }
}
