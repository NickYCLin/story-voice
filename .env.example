# Local Docker Compose only. Use strong secrets outside development.
POSTGRES_PASSWORD=storyvoice_local
STORYVOICE_API_PORT=8080
STORYVOICE_WEB_PORT=3000
STORYVOICE_BASE_PATH=/
VOAI_BASE_URL=https://connect.voai.ai/
# Paid cloud TTS is disabled unless this separate opt-in key is populated.
VOAI_PAID_API_KEY=
BLUEMAGPIE_ENABLED=false
# Separate opt-in: fixed-sentence preview can stay enabled while book text remains blocked.
BLUEMAGPIE_FORMAL_NARRATION_ENABLED=false
BLUEMAGPIE_INTERNAL_TOKEN=
BLUEMAGPIE_CACHE_PATH=./.cache/bluemagpie
BLUEMAGPIE_QUEUE_TIMEOUT_SECONDS=15
BLUEMAGPIE_SYNTHESIS_WATCHDOG_SECONDS=120
BLUEMAGPIE_MODEL_LIFECYCLE_WATCHDOG_SECONDS=120
BLUEMAGPIE_REQUEST_TIMEOUT_SECONDS=180
BLUEMAGPIE_MAXIMUM_RESPONSE_BYTES=5242880
BLUEMAGPIE_MAXIMUM_CHUNKS_PER_JOB=10000
BLUEMAGPIE_MAXIMUM_JOB_AUDIO_BYTES=8589934592
# Private, owner-scoped CosyVoice preview. This never enables formal narration.
LOCAL_CLONE_PREVIEW_ENABLED=false
LOCAL_CLONE_INTERNAL_TOKEN=
LOCAL_CLONE_CHU_MING_YANG_LABEL=褚冥漾（周子謙 AI 合成聲線・由建立者管理｜私人試音）
LOCAL_CLONE_CHU_MING_YANG_REFERENCE_SHA256=
LOCAL_CLONE_CHU_MING_YANG_TRANSCRIPT_SHA256=
LOCAL_CLONE_LIN_RUO_QING_LABEL=林若晴（AI 合成聲線・由建立者管理｜私人試音）
LOCAL_CLONE_LIN_RUO_QING_REFERENCE_SHA256=
LOCAL_CLONE_LIN_RUO_QING_TRANSCRIPT_SHA256=
LOCAL_CLONE_GATEWAY_QUEUE_TIMEOUT_SECONDS=15
LOCAL_CLONE_GATEWAY_SYNTHESIS_WATCHDOG_SECONDS=180
LOCAL_CLONE_GATEWAY_READY_TIMEOUT_SECONDS=3
# Synthetic-only public catalog and subscription/commercial API. Both remain unusable
# until active authorizations, private assets, consumer hashes, and active usage grants
# are supplied through protected deployment config.
VOICE_CATALOG_ENABLED=false
VOICE_CATALOG_MAXIMUM_DEMO_BYTES=3145728
EXTERNAL_VOICE_API_ENABLED=false
EXTERNAL_VOICE_API_MAXIMUM_REQUEST_BYTES=4096
EXTERNAL_VOICE_API_MAXIMUM_TEXT_CHARACTERS=200
EXTERNAL_VOICE_API_MAXIMUM_TEXT_UTF8_BYTES=2048
EXTERNAL_VOICE_API_MAXIMUM_RESPONSE_BYTES=3145728
EXTERNAL_VOICE_API_REQUESTS_PER_MINUTE=3
EXTERNAL_VOICE_API_IDEMPOTENCY_CACHE_ENTRIES=32
EXTERNAL_VOICE_API_IDEMPOTENCY_TTL_MINUTES=10
# Regenerable, Worker-only raw WAV cache. It is deliberately separate from published audio.
BLUEMAGPIE_CHUNK_CACHE_MAXIMUM_BYTES=34359738368
BLUEMAGPIE_CHUNK_CACHE_LOW_WATERMARK_BYTES=25769803776
BLUEMAGPIE_CHUNK_CACHE_MINIMUM_FREE_BYTES=68719476736
BLUEMAGPIE_CHUNK_CACHE_RETENTION_HOURS=168
BLUEMAGPIE_CHUNK_CACHE_CLEANUP_INTERVAL_MINUTES=30
BLUEMAGPIE_CHUNK_CACHE_TEMP_RETENTION_MINUTES=60
NARRATION_LEASE_MINUTES=5
# Per Worker process; keep 1 for a single GPU. Allowed range: 1..4.
NARRATION_MAX_CONCURRENT_JOBS=1
